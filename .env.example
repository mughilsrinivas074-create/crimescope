# ==============================================================================
# CRIMESCOPE AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' in the project root:
#   cp .env.example .env
#
# IMPORTANT:
# - Do NOT commit your real '.env' file to Git (enforced in .gitignore).
# - Do NOT hardcode secrets in source code files.
# - Supply your genuine Mapillary, Gemini, and CARTO API keys below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI API CONFIGURATION (AI CRIME DATA ANALYSIS)
# ------------------------------------------------------------------------------
# 1. Obtain an API key from Google AI Studio: https://aistudio.google.com/
# 2. Paste your API key here (starts with AIzaSy...):
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# If left blank, CrimeScope AI automatically uses the Deterministic Grounded Fallback Engine.

# ------------------------------------------------------------------------------
# 2. MAPILLARY API CONFIGURATION (STREET-LEVEL IMAGERY & EXPLORATION)
# ------------------------------------------------------------------------------
# 1. Obtain a free client token from Mapillary Developer Dashboard:
#    https://www.mapillary.com/dashboard/developers
# 2. Paste your access token here (e.g. MLY|... or your Mapillary client token):
MAPILLARY_CLIENT_TOKEN=your_mapillary_client_token_here
VITE_MAPILLARY_CLIENT_TOKEN=your_mapillary_client_token_here
# If left blank, CrimeScope AI displays spatial cartography with informative setup notices.

# ------------------------------------------------------------------------------
# 3. CARTO BASEMAP API CONFIGURATION (CARTOGRAPHIC MAP TILES)
# ------------------------------------------------------------------------------
# 1. Obtain an API key from CARTO Dashboard: https://carto.com/
# 2. Paste your CARTO API key / Basemap token here:
CARTO_API_KEY=your_carto_api_key_here
VITE_CARTO_API_KEY=your_carto_api_key_here
# If left blank, CrimeScope AI automatically uses the high-contrast CartoDB Dark Matter tiles.

# ------------------------------------------------------------------------------
# 4. SERVER & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
SERVER_PORT=8080
VITE_API_BASE_URL=http://localhost:8080/api

# ------------------------------------------------------------------------------
# 5. DATABASE CONFIGURATION (OPTIONAL FOR MYSQL PRODUCTION)
# ------------------------------------------------------------------------------
# By default, CrimeScope AI runs zero-config with H2 in MySQL Compatibility Mode.
# To connect to an external MySQL 8.x server, launch with --spring.profiles.active=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crimescopedb
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# ------------------------------------------------------------------------------
# 6. SPRING SECURITY & JWT CONFIGURATION
# ------------------------------------------------------------------------------
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
